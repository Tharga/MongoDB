@using Microsoft.Extensions.Options
@using Tharga.Blazor
@using Tharga.Blazor.Framework.Buttons
@using Tharga.MongoDB
@using Tharga.MongoDB.Configuration
@using Tharga.Toolkit
@implements IDisposable
@inject IDatabaseMonitor DatabaseMonitor;
@inject DialogService DialogService
@inject IOptions<DatabaseOptions> DatabaseOptions
@inject ICallLibrary CallLibrary
@inject CollectionInfoCache InfoCache

@if (!DatabaseOptions.Value.Monitor.Enabled)
{
    <RadzenText>Database monitor is disabled.</RadzenText>
}
else if (_model == null)
{
    <Loading />
}
else
{
    <RadzenStack Orientation="Orientation.Vertical">
        <RadzenRow>
            <RadzenColumn>
                <RadzenStack Orientation="Orientation.Vertical">
                    <RadzenText TextStyle="TextStyle.Caption" Text="Registration" />
                    <RadzenSelectBar TValue="IEnumerable<Registration>" @bind-Value="@SelectedRegistrationTypes" Change="@ReloadDataAsync" Style="margin-bottom: 6px;" Multiple="true">
                        <Items>
                            <RadzenSelectBarItem Text="Static" Value="Registration.Static" />
                            <RadzenSelectBarItem Text="Dynamic" Value="Registration.Dynamic" />
                            <RadzenSelectBarItem Text="Not in Code" Value="Registration.NotInCode" />
                        </Items>
                    </RadzenSelectBar>
                </RadzenStack>
            </RadzenColumn>
            @if (_sources.Length > 1)
            {
            <RadzenColumn>
                <RadzenStack Orientation="Orientation.Vertical">
                    <RadzenText TextStyle="TextStyle.Caption" Text="Sources"/>
                    <RadzenDropDown Placeholder="Select sources" @bind-Value=@SelectedSources Data=@_sources Multiple=true Style="margin-bottom: 6px;" Change="@ReloadDataAsync" />
                </RadzenStack>
            </RadzenColumn>
            }
            @if (_showDatabase)
            {
            <RadzenColumn>
                <RadzenStack Orientation="Orientation.Vertical">
                    <RadzenText TextStyle="TextStyle.Caption" Text="Databases"/>
                    <RadzenDropDown Placeholder="Select databases" @bind-Value=@SelectedDatabases Data=@_databases Multiple=true Style="margin-bottom: 6px;" Change="@ReloadDataAsync" />
                </RadzenStack>
            </RadzenColumn>
            }
        </RadzenRow>

        <RadzenDataGrid @ref="_grid" Data="_model" TItem="CollectionModel"
                        AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        AllowSorting="true"
                        AllowPaging="true" PageSize="8" PageSizeOptions="[8, 16, 32, 64]"
                        ShowPagingSummary="true" PagingSummaryFormat="@("{2:N0} collections, page {0} of {1}")"
                        CellRender="@OnCellRender"
                        Page="@OnGridPaged">
            <Columns>
                <RadzenDataGridColumn Title="Source" Visible="@_showSource" Sortable="false" Filterable="false" Width="200px" CssClass="css-source">
                    <Template>
                        <span title="@SourceTooltip(context)">@SourceCellText(context)</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Configuration" Property="@nameof(CollectionModel.ConfigurationNameText)" Visible="@_showConfiguration" />
                <RadzenDataGridColumn Title="Database" Property="@nameof(CollectionModel.DatabaseName)" Visible="@_showDatabase" />
                <RadzenDataGridColumn Title="Collection" Property="@nameof(CollectionModel.CollectionName)" />
                <RadzenDataGridColumn Title="Discovery" Property="@nameof(CollectionModel.Discovery)" Filterable="false"/>
                <RadzenDataGridColumn Title="Registration" Property="@nameof(CollectionModel.Registration)" Filterable="false" Width="120px" />
                <RadzenDataGridColumn Title="Documents" TextAlign="TextAlign.Right" CssClass="css-count" Sortable="false" Filterable="false" Width="120px">
                    <Template>
                        <StatsCell Model="@context" Field="StatsField.Documents" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Size" TextAlign="TextAlign.Right" Filterable="false" CssClass="css-size" Sortable="false" Width="120px">
                    <Template>
                        <StatsCell Model="@context" Field="StatsField.Size" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Indices" Property="@nameof(CollectionModel.IndexEqualFields)" CssClass="css-indices" Width="120px">
                    <Template>
                        <span title="@context.Indices.Diff()">@(context.IndexEqualFields?.ToString() ?? "")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Clean" Sortable="false" Filterable="false" CssClass="css-clean" Width="100px">
                    <Template>
                        @if (context.Clean != null)
                        {
                            <span title="@context.Clean.CleanedAt.ToLocalDateTimeString()">@context.Clean.CleanedAt.ToLocalDurationString()</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Calls" Property="@nameof(CollectionModel.CallCount)" Filterable="false" Sortable="true" TextAlign="TextAlign.Right" CssClass="css-calls" Width="80px">
                    <Template>
                        <CallCountCell Model="@context" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="" Sortable="false" Width="60px;" Filterable="false">
                    <Template>
                        <StandardButton Icon="format_list_numbered" Click="@(() => ShowCollectionDialog(context))" Style="margin-right: 3px;" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenStack>
}

@code {
    private string[] _sources = [];
    private string[] _databases;
    private CollectionModel[] _model;
    private RadzenDataGrid<CollectionModel> _grid;
    private bool _showConfiguration;
    private bool _showSource;
    private bool _showDatabase;
    private CollectionInfo[] _all;

    private IEnumerable<Registration> SelectedRegistrationTypes { get; set; }
    private IEnumerable<string> SelectedSources { get; set; }
    private IEnumerable<string> SelectedDatabases { get; set; }

    [Parameter]
    public bool FullDatabaseScan { get; set; }

    [Parameter]
    public string Filter { get; set; }

    private RevalidationQueue _revalidator;
    private HashSet<string> _visibleKeys = new();
    private const int DefaultPageSize = 8;

    protected override async Task OnInitializedAsync()
    {
        _revalidator = new RevalidationQueue(RevalidateOneAsync);
        DatabaseMonitor.CollectionInfoChangedEvent += OnCollectionInfoChanged;
        DatabaseMonitor.CollectionDroppedEvent += OnCollectionDropped;
        DatabaseMonitor.MonitorClientsChanged += OnMonitorClientsChanged;
        CallLibrary.CallChanged += OnCallChanged;
        await base.OnInitializedAsync();
    }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        DatabaseMonitor.CollectionInfoChangedEvent -= OnCollectionInfoChanged;
        DatabaseMonitor.CollectionDroppedEvent -= OnCollectionDropped;
        DatabaseMonitor.MonitorClientsChanged -= OnMonitorClientsChanged;
        CallLibrary.CallChanged -= OnCallChanged;
        _revalidator?.Dispose();
    }

    private async void OnCallChanged(object sender, EventArgs e)
    {
        if (_disposed || _model == null) return;

        try { await InvokeAsync(UpdateCallCounts); }
        catch (ObjectDisposedException) { }
    }

    private void UpdateCallCounts()
    {
        var callCountsBySuffix = CallLibrary.GetCallCountsBySuffix();
        foreach (var m in _model)
        {
            var suffix = $".{m.DatabaseName}.{m.CollectionName}";
            var next = callCountsBySuffix.TryGetValue(suffix, out var count) ? count : 0;
            if (next == m.CallCount) continue;

            m.CallCount = next;
            m.NotifyChanged();
        }
    }

    private async void OnCollectionInfoChanged(object sender, CollectionInfoChangedEventArgs e)
    {
        if (_disposed || _all == null) return;

        var item = _all.SingleOrDefault(x => x.Key == e.CollectionInfo.Key);

        if (item == null)
        {
            // New remote collection — add it and reload (ReloadDataAsync reloads the grid).
            _all = _all.Append(e.CollectionInfo).ToArray();
            UpdateFilterOptions();
            await ReloadDataAsync();
            return;
        }

        // Replace the snapshot entry wholesale so immutable fields (Registration, EntityTypes,
        // CollectionType name) stay fresh — a later rebuild (filter/drop/refresh) would otherwise
        // revert them. Mutating only Stats/Discovery/Index (as before) left Registration stale.
        _all = _all.Select(x => x.Key == e.CollectionInfo.Key ? e.CollectionInfo : x).ToArray();

        var m = _model?.SingleOrDefault(x => x.Key == e.CollectionInfo.Key);
        if (m == null)
        {
            // Row isn't in the filtered model (filtered out, or filters not built yet). A rebuild
            // surfaces it if it now matches; this fires on classification changes, not every access.
            UpdateFilterOptions();
            await ReloadDataAsync();
            return;
        }

        var indexModels = e.CollectionInfo.ToIndexModel().ToArray();
        var sources = DatabaseMonitor.GetCollectionSources(e.CollectionInfo.Key).ToArray();
        var newIndexEqual = e.CollectionInfo.Index?.Current == null ? (bool?)null : indexModels.All(x => x.EqualFields);

        // The grid renders these directly (columns + OnCellRender chrome). Per-cell components
        // (Documents/Size/Calls) update on NotifyChanged without a grid render — so only pay for a
        // grid reload when something the grid itself draws actually changed. This both fixes the
        // stale Registration and avoids reloading the grid on every forwarded collection access.
        var gridAffecting =
            m.Registration != e.CollectionInfo.Registration
            || m.Discovery != e.CollectionInfo.Discovery
            || m.IndexEqualFields != newIndexEqual
            || (m.Stats == null) != (e.CollectionInfo.Stats == null)
            || (m.Clean == null) != (e.CollectionInfo.Clean == null)
            || !m.Sources.SequenceEqual(sources);

        m.Discovery = e.CollectionInfo.Discovery;
        m.Registration = e.CollectionInfo.Registration;
        m.Stats = e.CollectionInfo.Stats;
        m.Size = e.CollectionInfo.Stats?.Size ?? 0;
        m.Indices = indexModels;
        m.IndexEqualFields = newIndexEqual;
        m.Clean = e.CollectionInfo.Clean;
        m.Sources = sources;
        // A source accessing this collection necessarily has access to its database — keep the "could reach"
        // set a superset of the accessors (full cross-collection refresh happens on the next reload).
        m.DatabaseSources = (m.DatabaseSources ?? []).Union(sources).OrderBy(s => s, StringComparer.Ordinal).ToArray();

        UpdateFilterOptions();
        m.NotifyChanged();
        if (gridAffecting)
            await RefreshGridAsync();
    }

    private async void OnCollectionDropped(object sender, CollectionDroppedEventArgs e)
    {
        if (_disposed || _all == null) return;

        // Prefer the resolved identity carried on the event (reliable); fall back to DatabaseContext
        // equality for older callers that didn't populate it.
        bool Matches(CollectionInfo x) =>
            e.DatabaseName != null
                ? x.DatabaseName == e.DatabaseName
                  && x.CollectionName == e.CollectionName
                  && (e.ConfigurationName == null || x.ConfigurationName?.Value == e.ConfigurationName)
                : x.ToDatabaseContext() == e.DatabaseContext;

        foreach (var dropped in _all.Where(Matches))
        {
            InfoCache.Remove(dropped.Key);
        }

        _all = _all.Where(x => !Matches(x)).ToArray();
        await ReloadDataAsync();
    }

    // An agent connecting/disconnecting changes who can reach each collection. Recompute sources so the
    // Source tooltip drops the gone agent and the "no source can reach it" highlight appears. The collection
    // itself stays in view (it lingers in _all) — only its reachability changed.
    private async void OnMonitorClientsChanged(object sender, EventArgs e)
    {
        if (_disposed || _all == null) return;
        try
        {
            await InvokeAsync(async () =>
            {
                UpdateFilterOptions();
                await ReloadDataAsync();
            });
        }
        catch (ObjectDisposedException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!InfoCache.IsEmpty)
        {
            // Stale-while-revalidate: render cached state synchronously, refresh in background.
            _all = InfoCache.GetAll().ToArray();
            UpdateFilterOptions();
            await ReloadDataAsync();
            EnqueueAllForRevalidation();
        }
        else
        {
            await LoadFromMongoAsync();
        }

        await base.OnParametersSetAsync();
    }

    public async Task RefreshAsync()
    {
        await LoadFromMongoAsync();
    }

    private async Task LoadFromMongoAsync()
    {
        _all = await DatabaseMonitor.GetInstancesAsync(FullDatabaseScan, Filter).ToArrayAsync();
        foreach (var info in _all) InfoCache.Upsert(info);
        UpdateFilterOptions();
        await ReloadDataAsync();
    }

    private void EnqueueAllForRevalidation()
    {
        if (_model == null) return;
        // Visible-page rows go high-priority, rest go low-priority.
        // The grid's PageChange handler (OnGridPaged) re-prioritises as the
        // user pages around — until then, the default first page is high.
        var firstPage = _model.Take(DefaultPageSize).Select(x => x.Key).ToArray();
        _visibleKeys = new HashSet<string>(firstPage);
        _revalidator.EnqueueHighMany(firstPage);
        _revalidator.EnqueueLowMany(_model.Skip(DefaultPageSize).Select(x => x.Key));
    }

    private async Task RevalidateOneAsync(string key, System.Threading.CancellationToken ct)
    {
        if (_disposed) return;

        var stale = _all?.FirstOrDefault(x => x.Key == key);
        if (stale == null) return;

        var marked = _model?.FirstOrDefault(x => x.Key == key);
        if (marked != null)
        {
            marked.IsRevalidating = true;
            marked.NotifyChanged();
            await NotifyVisibleCellChromeAsync(key);
        }

        try
        {
            var info = await DatabaseMonitor.GetInstanceAsync(stale);
            if (info == null || _disposed) return;

            InfoCache.Upsert(info);

            var m = _model?.FirstOrDefault(x => x.Key == info.Key);
            if (m == null) return;

            var indexModels = info.ToIndexModel().ToArray();
            m.Stats = info.Stats;
            m.Discovery = info.Discovery;
            m.Size = info.Stats?.Size ?? 0;
            m.Indices = indexModels;
            m.IndexEqualFields = info.Index == null || info.Index.Current == null ? null : indexModels.All(x => x.EqualFields);
            m.Clean = info.Clean;
        }
        finally
        {
            if (marked != null)
            {
                marked.IsRevalidating = false;
                marked.NotifyChanged();
                await NotifyVisibleCellChromeAsync(key);
            }
        }
    }

    // The cell BACKGROUND (loading/yellow/pink) is set by OnCellRender on the
    // RadzenDataGrid, which only re-fires on grid StateHasChanged. Per-cell
    // components handle the cell CONTENT (numbers, text) without grid re-render.
    // Trigger a grid re-render ONLY when the toggling row is currently visible
    // so off-screen IsRevalidating transitions cost nothing.
    private async Task NotifyVisibleCellChromeAsync(string key)
    {
        if (_disposed) return;
        if (!_visibleKeys.Contains(key)) return;
        await RefreshGridAsync();
    }

    // For an IN-PLACE update — _model is the same array, its elements mutated (touch, revalidation).
    // A parent StateHasChanged won't make RadzenDataGrid re-read unchanged rows, so Reload() re-applies
    // the view over the current Data, re-running CellRender (yellow "unknown"/pink "mismatch" chrome)
    // and the plain templates such as Indices. Marshalled since events can arrive off the UI thread.
    private async Task RefreshGridAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(async () =>
            {
                if (_grid != null) await _grid.Reload();
                else StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    // For a REFERENCE change — _model was reassigned (rows added/removed, filters, refresh). A parent
    // StateHasChanged pushes the new Data into the grid, which rebuilds its view (and re-runs
    // CellRender) from it. Reload() must NOT be used here: it re-applies over the grid's still-stale
    // Data parameter (set on the previous render), so added/removed rows wouldn't appear.
    private async Task RenderAsync()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
    }

    private void OnGridPaged(PagerEventArgs args)
    {
        if (_model == null || _revalidator == null) return;
        var pageRows = _model.Skip(args.Skip).Take(args.Top).Select(x => x.Key).ToArray();
        _visibleKeys = new HashSet<string>(pageRows);
        _revalidator.EnqueueHighMany(pageRows);
    }

    private void UpdateFilterOptions()
    {
        _sources = _all.SelectMany(x => DatabaseMonitor.GetCollectionSources(x.Key)).Distinct().Order().ToArray();
        _databases = _all.Select(x => x.DatabaseName).Distinct().Order().ToArray();
        // Show the Source column with >1 source, or whenever a collection has no source left that can reach it
        // (e.g. after its only agent disconnected) so the "orphaned" yellow highlight is visible.
        _showSource = _sources.Length > 1 || _all.Any(x => !DatabaseMonitor.GetCollectionSources(x.Key).Any());
        _showDatabase = _databases.Length > 1;
        _showConfiguration = _all.Select(x => x.ConfigurationName).Distinct().Count() > 1;
    }

    private async Task ShowCollectionDialog(CollectionModel context)
    {
        var parameters = new Dictionary<string, object> { { "Fingerprint", context } };
        var dialogOptions = new DialogOptions { Resizable = true, Draggable = true };
        var result = await DialogService.OpenAsync<CollectionDialog>(context.CollectionName, parameters, dialogOptions);
        if (result != true) return;

        await ReloadDataAsync();
    }

    // Cell text: the sources that have accessed this collection, plus — named, not just counted — any other
    // sources that can reach the same database but haven't accessed this collection (e.g. a reconnected client).
    private static string SourceCellText(CollectionModel m)
    {
        var accessed = m.Sources ?? [];
        var all = m.DatabaseSources is { Length: > 0 } ? m.DatabaseSources : accessed;
        var others = all.Where(s => !accessed.Contains(s)).ToArray();
        var accessedText = string.Join(", ", accessed);
        if (others.Length == 0) return accessedText;
        var othersText = string.Join(", ", others);
        return accessed.Length == 0 ? othersText : $"{accessedText} (+{othersText})";
    }

    // Tooltip listing every source with access to this collection's physical database, marking which have
    // actually accessed this collection versus which could reach it (e.g. via a different configuration).
    private static string SourceTooltip(CollectionModel m)
    {
        var db = string.IsNullOrEmpty(m.Server) ? m.DatabaseName : $"{m.Server}/{m.DatabaseName}";
        var accessed = new HashSet<string>(m.Sources ?? [], StringComparer.Ordinal);
        var all = m.DatabaseSources is { Length: > 0 } ? m.DatabaseSources : (m.Sources ?? []);
        if (all.Length == 0) return $"No sources recorded for {db}.";
        var lines = all.Select(s => accessed.Contains(s) ? $"{s} — accessed" : $"{s} — could reach");
        return $"Access to {db}:\n" + string.Join("\n", lines);
    }

    private async Task ReloadDataAsync()
    {
        var callCountsBySuffix = CallLibrary.GetCallCountsBySuffix();

        // Sources that could reach each physical database (server + database name): the union of every
        // source that has reported a collection there — even via a different configuration name. This is the
        // "could access" set behind the Source tooltip.
        var dbSources = new Dictionary<(string Server, string Database), HashSet<string>>();
        foreach (var x in _all)
        {
            var key = (x.Server ?? "", x.DatabaseName ?? "");
            if (!dbSources.TryGetValue(key, out var set))
                dbSources[key] = set = new HashSet<string>(StringComparer.Ordinal);
            foreach (var s in DatabaseMonitor.GetCollectionSources(x.Key))
                set.Add(s);
        }

        // Build all models with sources
        var allModels = _all
            .Select(x =>
            {
                var indexModels = x.ToIndexModel().ToArray();
                var suffix = $".{x.DatabaseName}.{x.CollectionName}";
                var count = callCountsBySuffix.TryGetValue(suffix, out var c) ? c : 0;

                var sources = DatabaseMonitor.GetCollectionSources(x.Key).ToArray();
                var isLocal = x.CollectionType != null;
                var databaseSources = dbSources.TryGetValue((x.Server ?? "", x.DatabaseName ?? ""), out var ds)
                    ? ds.OrderBy(s => s, StringComparer.Ordinal).ToArray()
                    : sources;

                return new CollectionModel
                {
                    ConfigurationName = x.ConfigurationName,
                    Stats = x.Stats,
                    DatabaseName = x.DatabaseName,
                    CollectionName = x.CollectionName,
                    Server = x.Server,
                    Discovery = x.Discovery,
                    Registration = x.Registration,
                    Size = x.Stats?.Size ?? 0,
                    Indices = indexModels,
                    IndexEqualFields = x.Index == null || x.Index.Current == null
                        ? null
                        : indexModels.All(y => y.EqualFields),
                    Clean = x.Clean,
                    CallCount = count,
                    Sources = sources,
                    DatabaseSources = databaseSources,
                    IsLocal = isLocal,
                };
            })
            .ToArray();

        // Apply filters
        _model = allModels
            .Where(x => SelectedSources == null || !SelectedSources.Any() || x.Sources.Any(s => SelectedSources.Contains(s)))
            .Where(x => SelectedDatabases == null || !SelectedDatabases.Any() || SelectedDatabases.Contains(x.DatabaseName))
            .Where(x => SelectedRegistrationTypes == null || !SelectedRegistrationTypes.Any() || SelectedRegistrationTypes.Contains(x.Registration))
            .ToArray();

        // _model was just reassigned (new array). Trigger a parent render so the grid rebinds to it
        // and re-renders rows + chrome; Reload() would re-apply over the stale Data parameter.
        await RenderAsync();
    }

    void OnCellRender(DataGridCellRenderEventArgs<CollectionModel> args)
    {
        var cssClass = args.Column.CssClass;
        if (string.IsNullOrEmpty(cssClass)) return;

        // Loading takes precedence over the unknown-value yellow / mismatch pink.
        // Uses Radzen's info-light theme token so it adapts to light/dark themes.
        if (args.Data.IsRevalidating && (
            cssClass.StartsWith("css-count") || cssClass.StartsWith("css-size") ||
            cssClass.StartsWith("css-indices") || cssClass.StartsWith("css-clean") ||
            cssClass.StartsWith("css-calls")))
        {
            SetColor(args, "var(--rz-info-light)");
            return;
        }

        if (cssClass.StartsWith("css-count"))
        {
            string color = args.Data.Stats == null ? "lightyellow" : null;
            SetColor(args, color);
        }
        else if (cssClass.StartsWith("css-size"))
        {
            string color = args.Data.Stats == null ? "lightyellow" : null;
            SetColor(args, color);
        }
        else if (cssClass.StartsWith("css-indices"))
        {
            string color = null;
            if (args.Data.IndexEqualFields == null)
            {
                color = "lightyellow";
            }
            else if (args.Data.IndexEqualFields == false)
            {
                color = "pink";
            }

            SetColor(args, color);
        }
        else if (cssClass.StartsWith("css-clean"))
        {
            string color = args.Data.Clean == null ? "lightyellow" : null;
            SetColor(args, color);
        }
        else if (cssClass.StartsWith("css-source"))
        {
            // No source can currently reach this collection's database (e.g. its only agent disconnected).
            string color = args.Data.DatabaseSources is { Length: > 0 } ? null : "lightyellow";
            SetColor(args, color);
        }
    }

    private static void SetColor(DataGridCellRenderEventArgs<CollectionModel> args, string color)
    {
        if (color is null) return;

        if (args.Attributes.TryGetValue("style", out var existing))
        {
            args.Attributes["style"] = existing + $"background-color: {color};";
        }
        else
        {
            args.Attributes.Add("style", $"background-color: {color};");
        }
    }

}
