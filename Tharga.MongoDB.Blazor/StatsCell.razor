@using Tharga.MongoDB.Blazor
@using Tharga.Toolkit
@implements IDisposable

@if (Model.Stats != null)
{
    @switch (Field)
    {
        case StatsField.Documents:
            @($"{Model.Stats.DocumentCount:N0}")
            break;
        case StatsField.Size:
            @Model.Stats.Size.ToReadableByteSize()
            break;
    }
}

@code {
    [Parameter, EditorRequired]
    public CollectionModel Model { get; set; }

    [Parameter, EditorRequired]
    public StatsField Field { get; set; }

    private CollectionModel _subscribed;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Model)) return;

        if (_subscribed != null)
        {
            _subscribed.Changed -= OnModelChanged;
        }

        _subscribed = Model;

        if (_subscribed != null)
        {
            _subscribed.Changed += OnModelChanged;
        }
    }

    private void OnModelChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_subscribed != null)
        {
            _subscribed.Changed -= OnModelChanged;
            _subscribed = null;
        }
    }
}
