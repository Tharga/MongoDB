@using Tharga.Toolkit
@inject IDatabaseMonitor DatabaseMonitor
@inject NotificationService NotificationService

@if (Client == null)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" ShowIcon="true" AllowClose="false">
        No agent supplied.
    </RadzenAlert>
}
else if (_detail == null)
{
    <Tharga.Blazor.Loading />
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

        @* --- Identity --- *@
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            @if (_detail.Client.IsConnected)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Connected" />
            }
            else
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Disconnected" />
            }
            @if (_detail.Client.AuthKeyName != null)
            {
                <RadzenIcon Icon="lock" title="@_detail.Client.AuthKeyName" />
            }
            <RadzenText TextStyle="TextStyle.Subtitle1" Text="@(_detail.Client.SourceName ?? _detail.Client.Machine)" />
        </RadzenStack>

        <RadzenRow>
            <RadzenColumn>
                <RadzenText TextStyle="TextStyle.Caption" Text="Machine" />
                <RadzenText Text="@_detail.Client.Machine" />
            </RadzenColumn>
            <RadzenColumn>
                <RadzenText TextStyle="TextStyle.Caption" Text="Application" />
                <RadzenText Text="@_detail.Client.Type" />
            </RadzenColumn>
            <RadzenColumn>
                <RadzenText TextStyle="TextStyle.Caption" Text="Version" />
                <RadzenText Text="@_detail.Client.Version" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow>
            <RadzenColumn Size="4">
                <RadzenText TextStyle="TextStyle.Caption" Text="Connected" />
                <div>
                    <Tharga.Blazor.DateTimeView Date="@_detail.Client.ConnectTime" />
                </div>
            </RadzenColumn>
            <RadzenColumn>
                <RadzenText TextStyle="TextStyle.Caption" Text="Disconnected" />
                @if (_detail.Client.DisconnectTime.HasValue)
                {
                    <Tharga.Blazor.DateTimeView Date="@_detail.Client.DisconnectTime.Value" />
                }
                else
                {
                    <RadzenText Text="—" />
                }
            </RadzenColumn>
        </RadzenRow>

        @* --- Configuration (as reported by the agent) --- *@
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6" Text="Configuration" />
            @if (_detail.Client.Status == null)
            {
                <RadzenText TextStyle="TextStyle.Body2" Text="Not reported (older agent or not yet received)." Style="color: gray;" />
            }
            else
            {
                <RadzenRow>
                    <RadzenColumn>
                        <RadzenText TextStyle="TextStyle.Caption" Text="Call forwarding" />
                        <div>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                <RadzenSwitch Value="@_detail.Client.Status.ForwardCompletedCalls"
                                              Disabled="@(_busy || !_detail.Client.IsConnected)"
                                              Change="@ToggleCallForwardingAsync"
                                              title="@(_detail.Client.IsConnected ? "Turn completed-call forwarding on/off on this agent" : "Agent is disconnected")" />
                                <RadzenText TextStyle="TextStyle.Body2" Text="@(_detail.Client.Status.ForwardCompletedCalls ? "On" : "Off")" />
                            </RadzenStack>
                        </div>
                    </RadzenColumn>
                    <RadzenColumn>
                        <RadzenText TextStyle="TextStyle.Caption" Text="Queue interval" />
                        <RadzenText Text="@($"{_detail.Client.Status.QueueMetricIntervalMs:N0} ms")" />
                    </RadzenColumn>
                    <RadzenColumn>
                        <RadzenText TextStyle="TextStyle.Caption" Text="Storage mode" />
                        <RadzenText Text="@(_detail.Client.Status.StorageMode ?? "—")" />
                    </RadzenColumn>
                    <RadzenColumn>
                        <RadzenText TextStyle="TextStyle.Caption" Text="Command monitoring" />
                        <RadzenText Text="@(_detail.Client.Status.EnableCommandMonitoring ? "On" : "Off")" />
                    </RadzenColumn>
                </RadzenRow>
            }
        </RadzenCard>

        @* --- Activity tabs --- *@
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="@($"Collections received ({_detail.CollectionKeys.Count:N0})")">
                    @if (_detail.CollectionKeys.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Text="No collections reported yet." Style="color: gray;" />
                    }
                    else
                    {
                        <div style="max-height: 300px; overflow-y: auto;">
                            @foreach (var key in _detail.CollectionKeys)
                            {
                                <div><RadzenText TextStyle="TextStyle.Body2" Text="@key" /></div>
                            }
                        </div>
                    }
                </RadzenTabsItem>

                <RadzenTabsItem Text="@($"Recent calls ({_detail.RecentCalls.Count:N0})")">
                    @if (_detail.RecentCalls.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Text="@RecentCallsEmptyMessage" Style="color: gray;" />
                    }
                    else
                    {
                        <RadzenDataGrid Data="_detail.RecentCalls" TItem="CallInfo" AllowSorting="true" Density="Density.Compact"
                                        AllowPaging="false">
                            <Columns>
                                <RadzenDataGridColumn Title="Start" Property="@nameof(CallInfo.StartTime)" SortOrder="SortOrder.Descending">
                                    <Template>
                                        <Tharga.Blazor.DateTimeView Date="@context.StartTime" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Title="Collection" Property="@($"{nameof(CallInfo.Fingerprint)}.{nameof(CallInfo.Fingerprint.CollectionName)}")" />
                                <RadzenDataGridColumn Title="Function" Property="@nameof(CallInfo.FunctionName)" />
                                <RadzenDataGridColumn Title="Operation" Property="@nameof(CallInfo.Operation)" />
                                <RadzenDataGridColumn Title="Elapsed" Property="@nameof(CallInfo.Elapsed)">
                                    <Template>
                                        <Tharga.Blazor.TimeSpanView TimeSpan="@context.Elapsed" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenTabsItem>

                <RadzenTabsItem Text="Latest queue snapshot">
                    @if (_detail.QueueState == null)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Text="No queue metrics reported yet." Style="color: gray;" />
                        <RadzenText TextStyle="TextStyle.Caption"
                                    Text="Agents send queue metrics only while a live Queue view is open (Calls → Queue) — and only once they have a connection pool (i.e. have accessed MongoDB). Open that view to start collecting them for this agent."
                                    Style="color: gray;" />
                    }
                    else
                    {
                        <RadzenRow>
                            <RadzenColumn>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Queued" />
                                <RadzenText Text="@($"{_detail.QueueState.QueueCount:N0}")" />
                            </RadzenColumn>
                            <RadzenColumn>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Executing" />
                                <RadzenText Text="@($"{_detail.QueueState.ExecutingCount:N0}")" />
                            </RadzenColumn>
                            <RadzenColumn>
                                <RadzenText TextStyle="TextStyle.Caption" Text="Last Wait (ms)" />
                                <RadzenText Text="@($"{_detail.QueueState.LastWaitTimeMs:N1}")" />
                            </RadzenColumn>
                        </RadzenRow>
                    }
                </RadzenTabsItem>

                <RadzenTabsItem Text="@($"Communication ({_communication.Count:N0})")">
                    <RadzenText TextStyle="TextStyle.Caption"
                                Text="Recent SignalR messages this server has exchanged with the agent (newest first). Inbound = received from the agent; Outbound = sent to it. Bounded, in-memory diagnostic."
                                Style="color: gray;" />
                    @if (_communication.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Text="No messages recorded yet." Style="color: gray;" />
                    }
                    else
                    {
                        <RadzenDataGrid Data="_communication" TItem="CommunicationEvent" AllowSorting="true" Density="Density.Compact"
                                        AllowPaging="true" PageSize="10" PageSizeOptions="[10, 25, 50]" ShowPagingSummary="true"
                                        PagingSummaryFormat="@("{2:N0} messages, page {0} of {1}")">
                            <Columns>
                                <RadzenDataGridColumn Title="Time" Property="@nameof(CommunicationEvent.Timestamp)" SortOrder="SortOrder.Descending" Width="170px">
                                    <Template>
                                        <Tharga.Blazor.DateTimeView Date="@context.Timestamp" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Title="Direction" Property="@nameof(CommunicationEvent.Direction)" Width="110px">
                                    <Template>
                                        <RadzenBadge BadgeStyle="@(context.Direction == CommunicationDirection.Inbound ? BadgeStyle.Success : BadgeStyle.Info)"
                                                     Text="@(context.Direction == CommunicationDirection.Inbound ? "In" : "Out")" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Title="Message" Property="@nameof(CommunicationEvent.MessageType)" Width="160px" />
                                <RadzenDataGridColumn Title="Detail" Property="@nameof(CommunicationEvent.Summary)" />
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>

        @* --- Actions --- *@
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Refresh" Icon="refresh" Click="RefreshAsync" />
        </RadzenStack>
    </RadzenStack>
}

@code {
    [Parameter]
    public MonitorClientDto Client { get; set; }

    [Parameter]
    public int RecentCallLimit { get; set; } = 20;

    private MonitorClientDetail _detail;
    private IReadOnlyList<CommunicationEvent> _communication = [];
    private bool _busy;

    // When the agent has reported its config and call forwarding is off, no calls will ever arrive —
    // say so, rather than the ambiguous "none yet". If the config isn't known, keep the neutral message.
    private string RecentCallsEmptyMessage =>
        _detail?.Client.Status is { ForwardCompletedCalls: false }
            ? "Call forwarding is off."
            : "No calls received yet.";

    protected override void OnParametersSet()
    {
        Reload();
        base.OnParametersSet();
    }

    private Task RefreshAsync()
    {
        Reload();
        return Task.CompletedTask;
    }

    private async Task ToggleCallForwardingAsync(bool enabled)
    {
        if (Client?.SourceName == null) return;
        _busy = true;
        try
        {
            await DatabaseMonitor.SetClientCallForwardingAsync(Client.SourceName, enabled);
            NotificationService.Notify(new NotificationMessage { Summary = $"Call forwarding turned {(enabled ? "on" : "off")}." });
        }
        catch (Exception e)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Failed to change call forwarding.", Detail = e.Message });
        }
        finally
        {
            // Re-read so the switch reflects the agent's actual state (and reverts on failure).
            _busy = false;
            Reload();
        }
    }

    private void Reload()
    {
        if (Client == null) { _detail = null; _communication = []; return; }

        // Fall back to the agent we already have if no enriched detail is available (e.g. SourceName not yet
        // correlated, or no data reported). This avoids an endless loading spinner — the dialog always opens.
        var sourceName = Client.SourceName;
        _detail = (sourceName != null ? DatabaseMonitor.GetMonitorClientDetail(sourceName, RecentCallLimit) : null)
                  ?? new MonitorClientDetail { Client = Client, CollectionKeys = [], RecentCalls = [] };
        _communication = sourceName != null ? DatabaseMonitor.GetClientCommunication(sourceName) : [];
    }
}
