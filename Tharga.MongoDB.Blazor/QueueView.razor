@implements IAsyncDisposable
@inject IQueueMonitor QueueMonitor
@inject IDatabaseMonitor DatabaseMonitor
@inject IServiceProvider ServiceProvider

<RadzenStack Orientation="Orientation.Vertical" Gap="16px">

    @if (_connectionSummaries.Count > 0)
    {
        <RadzenText TextStyle="TextStyle.Subtitle1" Text="Cluster connections" />
        <RadzenText TextStyle="TextStyle.Caption" Style="margin-top:-8px;"
                    Text="Each card is one cluster (the server you connect to). The headline is the sum of open connections across every pool and source targeting it — the figure that counts against the cluster's limit. Below it, each pool, and within each pool one row per source (a single client/server process)." />
        <RadzenRow AlignItems="AlignItems.Start" Gap="16px">
            @foreach (var cluster in _connectionSummaries)
            {
                <RadzenColumn Size="12" SizeSM="6" SizeMD="4">
                    <RadzenCard Style="height:100%;">
                        @* Level 1 — CLUSTER: the grouping and the sum. *@
                        <RadzenText TextStyle="TextStyle.Overline" Text="Cluster" Style="margin:0; opacity:0.7;" />
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="@ClusterDisplay(cluster)" Style="margin:0;" title="@cluster.Cluster" />
                        @if (ClusterDisplay(cluster) != cluster.Cluster)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Text="@cluster.Cluster" Style="margin:0 0 4px 0; opacity:0.6;" />
                        }
                        @if (cluster.Limit.HasValue && cluster.Limit.Value > 0)
                        {
                            <RadzenText TextStyle="TextStyle.H6" Style="margin:0;" Text="@($"{cluster.OpenConnections:N0} / {cluster.Limit.Value:N0}")" />
                            <RadzenProgressBar Value="@cluster.OpenConnections" Max="@cluster.Limit.Value" ShowValue="false"
                                               ProgressBarStyle="@ProgressStyle(cluster)" Style="height: 8px;" />
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.H6" Style="margin:0;" Text="@($"{cluster.OpenConnections:N0} open")" />
                        }
                        <RadzenText TextStyle="TextStyle.Caption" Style="opacity:0.7;"
                                    Text="@($"sum across {cluster.SourceCount} source(s) · {cluster.Pools.Count} pool(s) · capacity {cluster.MaxConnections:N0}")" />

                        @* Level 2 — POOL: a distinct client pool (server-key) — also where the limiter queue lives.
                           Level 3 — SOURCE: one process, with its open connections and its queued/executing calls. *@
                        @foreach (var pool in cluster.Pools)
                        {
                            <RadzenStack Orientation="Orientation.Vertical" Gap="1px"
                                         Style="@($"margin-top:8px; padding-left:8px; border-left:3px solid {ColorFor(pool.ServerKey)};")">
                                <RadzenText TextStyle="TextStyle.Caption" Style="margin:0; font-weight:600;">
                                    Pool · @PoolConfigLabel(pool) · cap @pool.MaxPoolSize/source · @pool.OpenConnections open ·
                                    Q <span style="@MetricStyle(pool.QueueCount, pool.ServerKey)">@pool.QueueCount</span>
                                    / Exec <span style="@MetricStyle(pool.ExecutingCount, pool.ServerKey)">@pool.ExecutingCount</span>
                                </RadzenText>
                                @foreach (var src in pool.Sources)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Style="margin:0; padding-left:8px; opacity:0.85;">
                                        • @src.Source: @src.OpenConnections / @src.MaxPoolSize open ·
                                        Q <span style="@MetricStyle(src.QueueCount, pool.ServerKey)">@src.QueueCount</span>
                                        / Exec <span style="@MetricStyle(src.ExecutingCount, pool.ServerKey)">@src.ExecutingCount</span>
                                    </RadzenText>
                                }
                            </RadzenStack>
                        }
                    </RadzenCard>
                </RadzenColumn>
            }
        </RadzenRow>
    }

    @* One line per pool (queue summed / wait = worst across that pool's sources). Per-source detail stays in the
       cards above — so the graph stays readable even with many connected clients. *@
    <RadzenText TextStyle="TextStyle.Subtitle1" Text="Queue Depth (per pool)" />
    <RadzenChart Style="height: 250px;">
        @foreach (var pool in _poolSlots)
        {
            <RadzenLineSeries Data="@pool.Value" CategoryProperty="SlotIndex" ValueProperty="QueueCount" Title="@LabelFor(pool.Key)" Stroke="@ColorFor(pool.Key)" LineType="LineType.Solid" Smooth="true">
                <RadzenMarkers MarkerType="MarkerType.None" />
            </RadzenLineSeries>
        }
        <RadzenCategoryAxis Step="@AxisStep" FormatString="{0}" />
        <RadzenValueAxis Min="0">
            <RadzenGridLines Visible="true" />
        </RadzenValueAxis>
        <RadzenLegend Visible="false" />
    </RadzenChart>

    <RadzenText TextStyle="TextStyle.Subtitle1" Text="Wait Time (s, per pool)" />
    <RadzenChart Style="height: 250px;">
        @foreach (var pool in _poolSlots)
        {
            <RadzenLineSeries Data="@pool.Value" CategoryProperty="SlotIndex" ValueProperty="WaitTimeSec" Title="@LabelFor(pool.Key)" Stroke="@ColorFor(pool.Key)" LineType="LineType.Solid" Smooth="true">
                <RadzenMarkers MarkerType="MarkerType.None" />
            </RadzenLineSeries>
        }
        <RadzenCategoryAxis Step="@AxisStep" FormatString="{0}" />
        <RadzenValueAxis Min="0">
            <RadzenGridLines Visible="true" />
        </RadzenValueAxis>
        <RadzenLegend Visible="false" />
    </RadzenChart>

</RadzenStack>

@code {
    private const int TotalSlots = 120;
    private const int AxisStep = 20;
    private const int SampleIntervalMs = 500;
    private Timer _timer;
    private bool _disposed;
    private IAsyncDisposable _subscription;

    // Charts and colours are keyed by pool (serverKey) — one line per pool, queue summed across that pool's
    // sources. Per-source detail lives in the cards, so the graph stays readable with many connected clients.
    private readonly Dictionary<string, RingBuffer> _rings = new();
    private readonly Dictionary<string, string> _labels = new();
    private Dictionary<string, List<Slot>> _poolSlots = new();
    private IReadOnlyList<ClusterConnectionSummary> _connectionSummaries = [];
    private IClusterConfigStore _configStore;

    // Stable colour per pool (serverKey), assigned first-seen. The same colour drives the chart line (Stroke),
    // the card's pool dot/border, and the Q/Exec outlines on its source rows — so they all read as one pool.
    private static readonly string[] SeriesColors =
        ["#2196F3", "#FF9800", "#4CAF50", "#E91E63", "#00BCD4", "#9C27B0", "#FFC107", "#8BC34A", "#F44336", "#3F51B5"];
    private readonly Dictionary<string, string> _poolColors = new();

    // Charts/colours are keyed by serverKey; show the friendly label (config name(s)) instead.
    private string LabelFor(string serverKey) => _labels.TryGetValue(serverKey, out var label) ? label : serverKey;

    private string ColorFor(string serverKey) => _poolColors.TryGetValue(serverKey, out var c) ? c : "#9e9e9e";

    private static string ServerKeyOf(string poolKey)
    {
        var i = poolKey.IndexOf("::", StringComparison.Ordinal);
        return i >= 0 ? poolKey[(i + 2)..] : poolKey;
    }

    // Outline the metric in its pool's line colour only when active (> 0); otherwise leave it plain so the eye
    // is drawn to the pools that are actually queuing/executing.
    private string MetricStyle(int value, string serverKey)
        => value <= 0 ? "" : $"border:1px solid {ColorFor(serverKey)}; border-radius:4px; padding:0 4px; color:{ColorFor(serverKey)}; font-weight:600;";

    private static string PoolConfigLabel(ClusterPoolSummary p) =>
        p.ConfigurationNames.Count > 0 ? string.Join(", ", p.ConfigurationNames) : p.ServerKey;

    // Display name: the configured alias if set, otherwise the raw cluster host.
    private string ClusterDisplay(ClusterConnectionSummary c)
    {
        var alias = _configStore?.Get(c.Cluster)?.Alias;
        return string.IsNullOrWhiteSpace(alias) ? c.Cluster : alias;
    }

    private ProgressBarStyle ProgressStyle(ClusterConnectionSummary c)
    {
        if (!c.Limit.HasValue || c.Limit.Value <= 0) return ProgressBarStyle.Info;
        var cfg = _configStore?.Get(c.Cluster);
        var warn = cfg?.WarnThreshold ?? 0.75;
        var danger = cfg?.DangerThreshold ?? 0.90;
        var ratio = (double)c.OpenConnections / c.Limit.Value;
        return ratio >= danger ? ProgressBarStyle.Danger : ratio >= warn ? ProgressBarStyle.Warning : ProgressBarStyle.Success;
    }

    protected override async Task OnInitializedAsync()
    {
        BuildAllSlots();

        _configStore = ServiceProvider.GetService(typeof(IClusterConfigStore)) as IClusterConfigStore;

        var liveMonitoring = ServiceProvider.GetService(typeof(ILiveMonitoringSubscription)) as ILiveMonitoringSubscription;
        if (liveMonitoring != null)
            _subscription = await liveMonitoring.SubscribeAsync();

        _timer = new Timer(OnTick, null, SampleIntervalMs, SampleIntervalMs);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _timer?.Dispose();
        if (_subscription != null)
            await _subscription.DisposeAsync();
    }

    private async void OnTick(object state)
    {
        if (_disposed) return;

        try
        {
            var perPool = DatabaseMonitor.GetPerPoolQueueState();
            var connectionSummaries = DatabaseMonitor.GetClusterConnectionSummary();

            await InvokeAsync(() =>
            {
                _connectionSummaries = connectionSummaries;

                // Collapse the per-source ("{source}::{serverKey}") states into one entry per pool (serverKey):
                // queue summed, wait = worst (max) across the pool's sources.
                var byPool = new Dictionary<string, (int Queue, double Wait, IReadOnlyCollection<string> Configs)>();
                foreach (var (poolKey, poolState) in perPool)
                {
                    var serverKey = ServerKeyOf(poolKey);
                    byPool.TryGetValue(serverKey, out var agg);
                    agg.Queue += poolState.QueueCount;
                    agg.Wait = Math.Max(agg.Wait, poolState.LastWaitTimeMs);
                    if (poolState.ConfigurationNames is { Count: > 0 }) agg.Configs = poolState.ConfigurationNames;
                    byPool[serverKey] = agg;
                }

                foreach (var (serverKey, agg) in byPool)
                {
                    _labels[serverKey] = agg.Configs is { Count: > 0 } ? string.Join(", ", agg.Configs) : serverKey;

                    if (!_poolColors.ContainsKey(serverKey))
                        _poolColors[serverKey] = SeriesColors[_poolColors.Count % SeriesColors.Length];

                    if (!_rings.ContainsKey(serverKey))
                        _rings[serverKey] = new RingBuffer(TotalSlots);

                    _rings[serverKey].Add(agg.Queue, agg.Wait);
                }

                BuildAllSlots();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private void BuildAllSlots()
    {
        var result = new Dictionary<string, List<Slot>>();
        foreach (var (serverKey, ring) in _rings)
        {
            result[serverKey] = ring.BuildSlots();
        }
        _poolSlots = result;
    }

    private class RingBuffer
    {
        private readonly int[] _queue;
        private readonly double[] _wait;
        private readonly int _size;
        private int _head;

        public RingBuffer(int size)
        {
            _size = size;
            _queue = new int[size];
            _wait = new double[size];
        }

        public void Add(int queueCount, double waitTimeMs)
        {
            _queue[_head] = queueCount;
            _wait[_head] = waitTimeMs;
            _head = (_head + 1) % _size;
        }

        public List<Slot> BuildSlots()
        {
            var list = new List<Slot>(_size);
            for (var i = 0; i < _size; i++)
            {
                var ringIdx = (_head - 1 - i + _size) % _size;
                list.Add(new Slot
                {
                    SlotIndex = i,
                    QueueCount = _queue[ringIdx],
                    WaitTimeSec = _wait[ringIdx] / 1000.0,
                });
            }
            return list;
        }
    }

    private class Slot
    {
        public int SlotIndex { get; init; }
        public int QueueCount { get; init; }
        public double WaitTimeSec { get; init; }
    }
}
