@implements IAsyncDisposable
@inject IQueueMonitor QueueMonitor
@inject IDatabaseMonitor DatabaseMonitor
@inject IServiceProvider ServiceProvider

<RadzenStack Orientation="Orientation.Vertical" Gap="16px">

    @if (_connectionSummaries.Count > 0)
    {
        <RadzenText TextStyle="TextStyle.Subtitle1" Text="Cluster connections (all sources)" />
        <RadzenRow AlignItems="AlignItems.Start" Gap="16px">
            @foreach (var cluster in _connectionSummaries)
            {
                <RadzenColumn Size="4">
                    <RadzenText TextStyle="TextStyle.Caption" Text="@ClusterLabel(cluster)" />
                    @if (cluster.Limit.HasValue && cluster.Limit.Value > 0)
                    {
                        <RadzenText TextStyle="TextStyle.Subtitle1" Text="@($"{cluster.OpenConnections:N0} / {cluster.Limit.Value:N0} open")" />
                        <RadzenProgressBar Value="@cluster.OpenConnections" Max="@cluster.Limit.Value" ShowValue="false"
                                           ProgressBarStyle="@ProgressStyle(cluster)" Style="height: 8px;" />
                    }
                    else
                    {
                        <RadzenText TextStyle="TextStyle.Subtitle1" Text="@($"{cluster.OpenConnections:N0} open")" />
                    }
                    <RadzenText TextStyle="TextStyle.Caption"
                                Text="@($"capacity {cluster.MaxConnections:N0} · {cluster.SourceCount} source(s)")" />
                </RadzenColumn>
            }
        </RadzenRow>
    }

    @* Grouped by configuration (≈ the Atlas connection pool). Each source — this server and every
       connected agent — has its own pool to that cluster, shown as a row under the configuration. *@
    <RadzenRow AlignItems="AlignItems.Start" Gap="16px">
        @foreach (var group in GroupByConfiguration())
        {
            <RadzenColumn Size="3">
                <RadzenText TextStyle="TextStyle.Subtitle2" Text="@group.Configuration" />
                @foreach (var pool in group.Pools)
                {
                    <RadzenText TextStyle="TextStyle.Body2"
                                Text="@($"{pool.Source} — Queue: {pool.State.QueueCount}  Exec: {pool.State.ExecutingCount}")" />
                }
            </RadzenColumn>
        }
    </RadzenRow>

    <RadzenText TextStyle="TextStyle.Subtitle1" Text="Queue Depth" />
    <RadzenChart Style="height: 250px;">
        @foreach (var source in _sourceSlots)
        {
            <RadzenLineSeries Data="@source.Value" CategoryProperty="SlotIndex" ValueProperty="QueueCount" Title="@LabelFor(source.Key)" LineType="LineType.Solid" Smooth="true">
                <RadzenMarkers MarkerType="MarkerType.None" />
            </RadzenLineSeries>
        }
        <RadzenCategoryAxis Step="@AxisStep" FormatString="{0}" />
        <RadzenValueAxis Min="0">
            <RadzenGridLines Visible="true" />
        </RadzenValueAxis>
        <RadzenLegend Visible="@(_sourceSlots.Count > 1)" />
    </RadzenChart>

    <RadzenText TextStyle="TextStyle.Subtitle1" Text="Wait Time (s)" />
    <RadzenChart Style="height: 250px;">
        @foreach (var source in _sourceSlots)
        {
            <RadzenLineSeries Data="@source.Value" CategoryProperty="SlotIndex" ValueProperty="WaitTimeSec" Title="@LabelFor(source.Key)" LineType="LineType.Solid" Smooth="true">
                <RadzenMarkers MarkerType="MarkerType.None" />
            </RadzenLineSeries>
        }
        <RadzenCategoryAxis Step="@AxisStep" FormatString="{0}" />
        <RadzenValueAxis Min="0">
            <RadzenGridLines Visible="true" />
        </RadzenValueAxis>
        <RadzenLegend Visible="@(_sourceSlots.Count > 1)" />
    </RadzenChart>

</RadzenStack>

@code {
    private const int TotalSlots = 120;
    private const int AxisStep = 20;
    private const int SampleIntervalMs = 500;
    private Timer _timer;
    private bool _disposed;
    private IAsyncDisposable _subscription;

    private readonly Dictionary<string, RingBuffer> _rings = new();
    private readonly Dictionary<string, string> _labels = new();
    private Dictionary<string, List<Slot>> _sourceSlots = new();
    private Dictionary<string, ConnectionPoolStateDto> _sourceStates = new();
    private IReadOnlyList<ClusterConnectionSummary> _connectionSummaries = [];

    // The pool key is unique ("{source}::{serverKey}"); display the friendly label (config name(s)) instead.
    private string LabelFor(string key) => _labels.TryGetValue(key, out var label) ? label : key;

    // Group the per-pool states by configuration (the logical Atlas pool). Each entry under a group is
    // one source's pool to that configuration — this server and every connected agent.
    private IReadOnlyList<PoolGroup> GroupByConfiguration()
    {
        return _sourceStates
            .Select(kvp => new PoolEntry(
                SourceOf(kvp.Key),
                kvp.Value.ConfigurationNames is { Count: > 0 }
                    ? string.Join(", ", kvp.Value.ConfigurationNames)
                    : ServerKeyOf(kvp.Key),
                kvp.Value))
            .GroupBy(x => x.Configuration)
            .OrderBy(g => g.Key, StringComparer.Ordinal)
            .Select(g => new PoolGroup(g.Key, g.OrderBy(x => x.Source, StringComparer.Ordinal).ToList()))
            .ToList();
    }

    private static string SourceOf(string poolKey)
    {
        var i = poolKey.IndexOf("::", StringComparison.Ordinal);
        return i >= 0 ? poolKey[..i] : poolKey;
    }

    private static string ServerKeyOf(string poolKey)
    {
        var i = poolKey.IndexOf("::", StringComparison.Ordinal);
        return i >= 0 ? poolKey[(i + 2)..] : poolKey;
    }

    private sealed record PoolEntry(string Source, string Configuration, ConnectionPoolStateDto State);
    private sealed record PoolGroup(string Configuration, IReadOnlyList<PoolEntry> Pools);

    private static string ClusterLabel(ClusterConnectionSummary c) =>
        c.ConfigurationNames.Count > 0 ? string.Join(", ", c.ConfigurationNames) : c.ServerKey;

    private static ProgressBarStyle ProgressStyle(ClusterConnectionSummary c)
    {
        if (!c.Limit.HasValue || c.Limit.Value <= 0) return ProgressBarStyle.Info;
        var ratio = (double)c.OpenConnections / c.Limit.Value;
        return ratio >= 0.9 ? ProgressBarStyle.Danger : ratio >= 0.75 ? ProgressBarStyle.Warning : ProgressBarStyle.Success;
    }

    protected override async Task OnInitializedAsync()
    {
        BuildAllSlots();

        var liveMonitoring = ServiceProvider.GetService(typeof(ILiveMonitoringSubscription)) as ILiveMonitoringSubscription;
        if (liveMonitoring != null)
            _subscription = await liveMonitoring.SubscribeAsync();

        _timer = new Timer(OnTick, null, SampleIntervalMs, SampleIntervalMs);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _timer?.Dispose();
        if (_subscription != null)
            await _subscription.DisposeAsync();
    }

    private async void OnTick(object state)
    {
        if (_disposed) return;

        try
        {
            var perPool = DatabaseMonitor.GetPerPoolQueueState();
            var connectionSummaries = DatabaseMonitor.GetClusterConnectionSummary();

            await InvokeAsync(() =>
            {
                _sourceStates = new Dictionary<string, ConnectionPoolStateDto>(perPool);
                _connectionSummaries = connectionSummaries;

                foreach (var (poolKey, poolState) in perPool)
                {
                    _labels[poolKey] = poolState.Label ?? poolKey;

                    if (!_rings.ContainsKey(poolKey))
                        _rings[poolKey] = new RingBuffer(TotalSlots);

                    _rings[poolKey].Add(poolState.QueueCount, poolState.LastWaitTimeMs);
                }

                BuildAllSlots();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private void BuildAllSlots()
    {
        var result = new Dictionary<string, List<Slot>>();
        foreach (var (source, ring) in _rings)
        {
            result[source] = ring.BuildSlots();
        }
        _sourceSlots = result;
    }

    private class RingBuffer
    {
        private readonly int[] _queue;
        private readonly double[] _wait;
        private readonly int _size;
        private int _head;

        public RingBuffer(int size)
        {
            _size = size;
            _queue = new int[size];
            _wait = new double[size];
        }

        public void Add(int queueCount, double waitTimeMs)
        {
            _queue[_head] = queueCount;
            _wait[_head] = waitTimeMs;
            _head = (_head + 1) % _size;
        }

        public List<Slot> BuildSlots()
        {
            var list = new List<Slot>(_size);
            for (var i = 0; i < _size; i++)
            {
                var ringIdx = (_head - 1 - i + _size) % _size;
                list.Add(new Slot
                {
                    SlotIndex = i,
                    QueueCount = _queue[ringIdx],
                    WaitTimeSec = _wait[ringIdx] / 1000.0,
                });
            }
            return list;
        }
    }

    private class Slot
    {
        public int SlotIndex { get; init; }
        public int QueueCount { get; init; }
        public double WaitTimeSec { get; init; }
    }
}
